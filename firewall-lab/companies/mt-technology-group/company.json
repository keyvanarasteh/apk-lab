{
  "schemaVersion": 1,
  "name": "MT Technology Group — Multi-Branch Firewall Design",
  "sector": "Technology / Education",
  "author": {
    "name": "D*** P***",
    "course": "BGT207",
    "github": "denizpekova"
  },
  "summary": "A fictional group with Istanbul HQ (data center, public website behind Cloudflare WAF, VPN hub, NOC/SOC), Ankara (government projects, backup NOC/SOC), London (UK-GDPR) and a 10,000-student academic branch, about 11,600 people in total. Bandwidth is computed with an explicit formula (x1.10 overhead, x1.35 growth), FortiGate HA pairs per site chosen from a top-5 with a capacity filter, per-site ordered rules ending in deny-all, and a NOC/SOC split with change control.",
  "branches": [
    {
      "id": "istanbul-hq",
      "name": "Istanbul Office (HQ)",
      "role": "headquarters",
      "location": "Istanbul, Turkey",
      "population": {
        "staff": 340,
        "software": 60,
        "rnd": 20
      },
      "network": {
        "cidr": "10.10.0.0/16",
        "dmz": true,
        "vlans": [
          {
            "id": 10,
            "name": "admin-staff",
            "cidr": "10.10.10.0/23"
          },
          {
            "id": 20,
            "name": "software",
            "cidr": "10.10.20.0/24"
          },
          {
            "id": 30,
            "name": "technical",
            "cidr": "10.10.30.0/24"
          },
          {
            "id": 40,
            "name": "security",
            "cidr": "10.10.40.0/24"
          },
          {
            "id": 50,
            "name": "rnd",
            "cidr": "10.10.50.0/24"
          },
          {
            "id": 60,
            "name": "servers",
            "cidr": "10.10.60.0/24",
            "note": "Infrastructure server 10.10.60.5 gives DHCP, DNS and NTP."
          },
          {
            "id": 70,
            "name": "guest-wifi",
            "cidr": "10.10.70.0/24",
            "note": "Internet only."
          },
          {
            "id": 80,
            "name": "network-management",
            "cidr": "10.10.80.0/24"
          },
          {
            "id": 90,
            "name": "dmz",
            "cidr": "10.10.90.0/24",
            "note": "Public website origin 10.10.90.10, reachable only through Cloudflare. No connections from the DMZ into internal networks."
          }
        ]
      },
      "bandwidth": {
        "downMbps": 5000,
        "upMbps": 5000,
        "drivers": [
          "data center and VPN 1,200 Mbps",
          "guest 60 Mbps",
          "software and R&D traffic",
          "public website through Cloudflare"
        ]
      },
      "firewalls": [
        {
          "segment": "perimeter",
          "chosen": {
            "product": "Fortinet FortiGate 400F",
            "vendor": "Fortinet",
            "throughputGbps": 9.0,
            "priceUsd": 12696,
            "reason": "Selected. Enough headroom on a 5 Gbps link; manages and logs all four sites"
          },
          "alternatives": [
            {
              "product": "Cisco Secure Firewall 3110",
              "vendor": "Cisco",
              "throughputGbps": 17.0,
              "priceUsd": 41524,
              "reason": "Qualifies. Talos threat intelligence; needs the separate FMC manager"
            },
            {
              "product": "Sophos XGS 5500",
              "vendor": "Sophos",
              "throughputGbps": 12.4,
              "priceUsd": 19399,
              "reason": "Qualifies. Simple to operate; weaker for central multi-site operations"
            },
            {
              "product": "Palo Alto PA-3410",
              "vendor": "Palo Alto Networks",
              "throughputGbps": 5.9,
              "priceUsd": 32584,
              "reason": "Qualifies. Strong App-ID and Panorama; little headroom at the low figure"
            },
            {
              "product": "Check Point Quantum 6600",
              "vendor": "Check Point",
              "throughputGbps": 3.7,
              "priceUsd": 39332,
              "reason": "Eliminated. Below 5 Gbps"
            }
          ],
          "rules": [
            {
              "action": "deny",
              "direction": "forward",
              "proto": "any",
              "from": "Internet with a private source address",
              "to": "Site networks",
              "note": "Common rule A: a private source address cannot arrive from the internet, so it is spoofed. Without this rule a spoofed packet could match the internal allow rules below."
            },
            {
              "action": "allow",
              "direction": "forward",
              "proto": "udp",
              "port": "500,4500",
              "from": "Ankara, London and campus firewalls",
              "to": "IPsec gateway on this firewall",
              "note": "Common rule B: IKEv2 and NAT traversal for the site-to-site tunnels. Without it the sites lose their private links."
            },
            {
              "action": "allow",
              "direction": "forward",
              "proto": "udp",
              "port": "67:68",
              "from": "All site VLANs",
              "to": "Infrastructure server 10.10.60.5",
              "note": "Common rule C: the firewall relays DHCP to this server. Without it deny-all leaves clients with no IP address. Guests reach this server for DHCP and DNS only."
            },
            {
              "action": "allow",
              "direction": "forward",
              "proto": "any",
              "port": "53",
              "from": "All site VLANs",
              "to": "Infrastructure server 10.10.60.5",
              "note": "Common rule D: DNS to the site resolver. Without it names stop resolving and every application appears to be down."
            },
            {
              "action": "allow",
              "direction": "forward",
              "proto": "udp",
              "port": "123",
              "from": "All site VLANs except guest",
              "to": "Infrastructure server 10.10.60.5",
              "note": "Common rule E: NTP from the site time source. Without it clocks drift, TLS checks fail and log timestamps stop being usable as evidence."
            },
            {
              "action": "allow",
              "direction": "forward",
              "proto": "any",
              "port": "53,123",
              "from": "Infrastructure server 10.10.60.5",
              "to": "Internet",
              "note": "Common rule F: only this server resolves names and fetches time upstream, so a single source is easy to monitor."
            },
            {
              "action": "allow",
              "direction": "forward",
              "proto": "tcp",
              "port": "443",
              "from": "Cloudflare IP ranges",
              "to": "DMZ website 10.10.90.10",
              "note": "Rule 1: only Cloudflare reaches the public website (HTTPS), after its WAF, and IPS inspects it again here. Without the source limit an attacker who finds the origin address could skip the WAF."
            },
            {
              "action": "allow",
              "direction": "forward",
              "proto": "any",
              "port": "22,443,161",
              "from": "NOC networks (Istanbul, Ankara)",
              "to": "Network management VLAN",
              "note": "Rule 2: NOC networks (Istanbul, Ankara) to Network management VLAN (SSH, HTTPS, SNMPv3) — Allow."
            },
            {
              "action": "allow",
              "direction": "forward",
              "proto": "any",
              "port": "514,6514",
              "from": "All sites",
              "to": "FortiAnalyzer and SIEM",
              "note": "Rule 3: All sites to FortiAnalyzer and SIEM (Syslog 514, 6514) — Allow."
            },
            {
              "action": "allow",
              "direction": "forward",
              "proto": "tcp",
              "port": "443,9200",
              "from": "Security VLANs (Istanbul, Ankara)",
              "to": "FortiAnalyzer and SIEM",
              "note": "Rule 4: Security VLANs (Istanbul, Ankara) to FortiAnalyzer and SIEM (HTTPS, 9200) — Allow."
            },
            {
              "action": "allow",
              "direction": "forward",
              "proto": "tcp",
              "port": "22,443",
              "from": "Software VLANs (all sites)",
              "to": "Git and CI/CD 10.10.60.40/29",
              "note": "Rule 5: Software VLANs (all sites) to Git and CI/CD `10.10.60.40/29` (SSH, HTTPS) — Allow."
            },
            {
              "action": "allow",
              "direction": "forward",
              "proto": "tcp",
              "port": "22,443,8888",
              "from": "R&D VLANs (Istanbul, Ankara, campus)",
              "to": "GPU cluster 10.10.60.64/27",
              "note": "Rule 6: R&D VLANs (Istanbul, Ankara, campus) to GPU cluster `10.10.60.64/27` (SSH, HTTPS, 8888) — Allow."
            },
            {
              "action": "allow",
              "direction": "forward",
              "proto": "tcp",
              "port": "443",
              "from": "Admin VLANs (all sites)",
              "to": "ERP 10.10.60.10",
              "note": "Rule 7: Admin VLANs (all sites) to ERP `10.10.60.10` (HTTPS) — Allow."
            },
            {
              "action": "deny",
              "direction": "forward",
              "from": "Guest VLAN",
              "to": "Internal networks",
              "note": "Rule 8: Guest VLAN to Internal networks (Any) — Deny."
            },
            {
              "action": "limit",
              "direction": "forward",
              "proto": "any",
              "port": "53,80,443",
              "from": "Guest VLAN",
              "to": "Internet",
              "note": "Rule 9: Guest VLAN to Internet (DNS, HTTP, HTTPS) — Allow, rate limited."
            },
            {
              "action": "allow",
              "direction": "forward",
              "proto": "any",
              "port": "53,80,443",
              "from": "Corporate VLANs",
              "to": "Internet",
              "note": "Rule 10: Corporate VLANs to Internet (DNS, HTTP, HTTPS) — Allow, with filtering."
            },
            {
              "action": "allow",
              "direction": "forward",
              "proto": "any",
              "port": "443,514,873",
              "from": "Servers VLAN",
              "to": "Ankara DR servers",
              "note": "Rule 11: Servers VLAN to Ankara DR servers (HTTPS, 514, rsync) — Allow."
            },
            {
              "action": "allow",
              "direction": "forward",
              "proto": "any",
              "port": "22,443,161",
              "from": "Istanbul NOC",
              "to": "Network management VLANs at the other sites",
              "note": "Rule 12: Istanbul NOC to Network management VLANs at the other sites (SSH, HTTPS, SNMPv3) — Allow."
            },
            {
              "action": "limit",
              "direction": "forward",
              "proto": "udp",
              "port": "500,4500",
              "from": "Internet",
              "to": "Remote-access gateway on the Istanbul firewall",
              "note": "Rule 13: role-based VPN logins from the internet, rate limited against password spraying. Certificate and MFA are required."
            },
            {
              "action": "allow",
              "direction": "forward",
              "proto": "any",
              "port": "22,443,161",
              "from": "VPN admin pool 10.10.100.0/26",
              "to": "Network management VLANs (all sites)",
              "note": "Rule 14: firewall engineers only, through the VPN and never from the internet directly (SSH, HTTPS, SNMPv3)."
            },
            {
              "action": "allow",
              "direction": "forward",
              "proto": "tcp",
              "port": "22,443",
              "from": "VPN developer pool 10.10.100.64/26",
              "to": "Git and CI/CD 10.10.60.40/29",
              "note": "Rule 15: remote developers reach Git and CI/CD only, so a stolen developer login cannot reach ERP or management."
            },
            {
              "action": "allow",
              "direction": "forward",
              "proto": "tcp",
              "port": "443",
              "from": "VPN staff pool 10.10.100.128/25",
              "to": "ERP 10.10.60.10",
              "note": "Rule 16: remote staff reach ERP only (HTTPS)."
            },
            {
              "action": "allow",
              "direction": "forward",
              "proto": "tcp",
              "port": "22",
              "from": "CI/CD 10.10.60.40/29",
              "to": "DMZ website 10.10.90.10",
              "note": "Rule 17: only CI/CD deploys the website. The connection starts from inside, so the DMZ still cannot start connections to the LAN."
            },
            {
              "action": "deny",
              "direction": "forward",
              "proto": "any",
              "note": "Every site ends with deny all and log."
            }
          ]
        }
      ]
    },
